# Application Settings
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:5500,http://localhost:3000,http://127.0.0.1:4200,http://127.0.0.1:8080,http://127.0.0.1:5500,http://127.0.0.1:3000

# Local Token Keys (Must be at least 32 characters long)
JWT_SECRET_KEY=change_this_to_a_random_32_character_string_minimum
JWT_EXPIRE_MINUTES=60

# PostgreSQL Connection Matrix
DB_HOST=localhost
DB_PORT=5440
DB_NAME=digital_library
DB_USER=postgres
DB_PASSWORD=secretpassword

# Cognito configuration. Use AWS pool/client values from Terraform outputs
# for AWS mode. For local mode, use the IDs printed by `cognito-init`.
USE_COGNITO=true
AWS_REGION=us-east-1
AWS_COGNITO_ENDPOINT=http://cognito-local:9229
COGNITO_LOCAL_ISSUER=http://localhost:9229
COGNITO_USER_POOL_ID=local_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Local emulator only. The API shows this code to local testers.
COGNITO_LOCAL_CODE=123456
