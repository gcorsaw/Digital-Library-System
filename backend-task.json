{
  "family": "backend-task",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "YOUR_ECR_REPOSITORY_URL/backend:latest",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AUTH_PROVIDER", "value": "COGNITO" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "COGNITO_USER_POOL_ID", "value": "us-east-1_xxxxxxxxx" },
        { "name": "JWT_SECRET", "value": "your_local_secret_fallback_key" },
        { "name": "API_BASE_URL", "value": "http://localhost:5000" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/backend-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512"
}
