# Backend image: FastAPI app managed with uv
FROM python:3.12-slim

# Install uv (fast Python package manager, matches your uv.lock)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy dependency files first so Docker can cache this layer
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Copy the rest of the application
COPY . .

# Use the virtualenv that uv sync created
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Start the API (main.py runs uvicorn on 0.0.0.0:8000)
CMD ["python", "main.py"]