# Dockerfile.backend
# Multi-stage production build structure for Python containers
FROM ghcr.io/astral-sh/uv:python3.10-bookworm-slim AS builder

WORKDIR /app

# Enable dependency layer caching optimization maps
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Final execution image layer
FROM python:3.10-slim AS runner

WORKDIR /app

# Copy runtime binaries and virtual environment configurations from builder stage
COPY --from=builder /app/.venv /app/.venv
COPY main.py .
COPY user-schema.sql .

ENV PATH="/app/.venv/bin:$PATH"

# Expose backend proxy connection mapping networks
EXPOSE 8000

# Cloud environment arguments populated automatically by Terraform clusters
ENV APP_ENV="production"
ENV DB_HOST=""
ENV DB_PORT="5440"
ENV DB_NAME=""
ENV DB_USER=""
ENV DB_PASSWORD=""
ENV JWT_SECRET_KEY=""
ENV ALLOWED_ORIGINS="*"
ENV COGNITO_USER_POOL_ID=""
ENV COGNITO_CLIENT_ID=""

CMD ["uvicorn", "main:library_app", "--host", "0.0.0.0", "--port", "8000"]
