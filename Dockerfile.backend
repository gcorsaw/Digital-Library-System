# THe Dockerfile.backend is going to create an image that is going to have the 
#version of the image would be 3.12-slim
FROM python:3.12-slim

# Install uv (fast Python package manager, matches your uv.lock)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Copy dependency files first to leverage caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --system

# Copy the rest of the application
COPY . .

EXPOSE 8000

# This command is going to tell Docker that when the container
# starts, it's going to run this command. The actual 
# runtime command is: uv run python main.py. 
CMD ["uv", "run", "python", "main.py"]